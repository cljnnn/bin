#!/usr/bin/env python3
"""Fetch a URL, extract the main article content, and emit Markdown."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path
from typing import NoReturn

import httpx
import trafilatura
from markdownify import markdownify as html_to_markdown


DEFAULT_TIMEOUT_SECONDS = 20.0
DEFAULT_USER_AGENT = "urlmd/1.0 (+https://github.com/adbar/trafilatura)"


class UrlmdError(Exception):
    """Raised for expected CLI errors."""


def fail(message: str, exit_code: int = 1) -> NoReturn:
    print(f"urlmd: error: {message}", file=sys.stderr)
    raise SystemExit(exit_code)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="urlmd",
        description="Fetch a URL, extract the readable main content, and convert it to Markdown.",
    )
    parser.add_argument("url", help="URL to fetch")
    parser.add_argument(
        "-o",
        "--output",
        type=Path,
        help="Write Markdown to this file instead of stdout",
    )
    parser.add_argument(
        "--title",
        action="store_true",
        help="Prefix the output with the extracted page title as a Markdown heading",
    )
    parser.add_argument(
        "--links",
        action="store_true",
        help="Keep links in the Markdown output",
    )
    parser.add_argument(
        "--images",
        action="store_true",
        help="Keep images in the Markdown output when available",
    )
    parser.add_argument(
        "--timeout",
        type=float,
        default=DEFAULT_TIMEOUT_SECONDS,
        help=f"Request timeout in seconds, default: {DEFAULT_TIMEOUT_SECONDS:g}",
    )
    parser.add_argument(
        "--raw-html",
        action="store_true",
        help="Convert full fetched HTML instead of extracting main content first",
    )
    return parser


def fetch_html(url: str, timeout: float) -> str:
    if timeout <= 0:
        raise UrlmdError("timeout must be greater than 0")

    headers = {"User-Agent": DEFAULT_USER_AGENT}

    try:
        with httpx.Client(follow_redirects=True, timeout=timeout, headers=headers) as client:
            response = client.get(url)
            response.raise_for_status()
    except httpx.HTTPStatusError as exc:
        status = exc.response.status_code
        raise UrlmdError(f"request failed with HTTP {status}: {url}") from exc
    except httpx.RequestError as exc:
        raise UrlmdError(f"request failed: {exc}") from exc

    content_type = response.headers.get("content-type", "")
    if content_type and "html" not in content_type.lower() and "text/plain" not in content_type.lower():
        raise UrlmdError(f"unsupported content type: {content_type}")

    return response.text


def extract_markdown(
    html: str,
    *,
    include_title: bool,
    include_links: bool,
    include_images: bool,
    raw_html: bool,
) -> str:
    if raw_html:
        markdown = html_to_markdown(
            html,
            heading_style="ATX",
            strip=[] if include_links else ["a"],
        )
        return normalize_markdown(markdown)

    metadata = trafilatura.extract_metadata(html)
    extracted = trafilatura.extract(
        html,
        output_format="markdown",
        include_comments=False,
        include_tables=True,
        include_links=include_links,
        include_images=include_images,
        favor_precision=True,
    )

    if not extracted:
        raise UrlmdError("could not extract main content; retry with --raw-html")

    markdown = normalize_markdown(extracted)
    if include_title and metadata and metadata.title:
        markdown = f"# {metadata.title.strip()}\n\n{markdown}"
    return markdown


def normalize_markdown(markdown: str) -> str:
    lines = [line.rstrip() for line in markdown.replace("\r\n", "\n").replace("\r", "\n").split("\n")]

    compacted: list[str] = []
    blank_count = 0
    for line in lines:
        if line:
            blank_count = 0
            compacted.append(line)
            continue

        blank_count += 1
        if blank_count <= 2:
            compacted.append(line)

    return "\n".join(compacted).strip() + "\n"


def write_output(markdown: str, output: Path | None) -> None:
    if output is None:
        print(markdown, end="")
        return

    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(markdown, encoding="utf-8")


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()

    try:
        html = fetch_html(args.url, args.timeout)
        markdown = extract_markdown(
            html,
            include_title=args.title,
            include_links=args.links,
            include_images=args.images,
            raw_html=args.raw_html,
        )
        write_output(markdown, args.output)
    except UrlmdError as exc:
        fail(str(exc))


if __name__ == "__main__":
    main()
